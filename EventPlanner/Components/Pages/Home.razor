@page "/"
@rendermode InteractiveServer
@using EventPlanner.Services
@inject IEventService EventService
@inject IWeatherService WeatherService
@inject EventSorter EventSorter
@inject WeatherValidator WeatherValidator

<PageTitle>EventPlanner | Discover Events</PageTitle>

<section class="search-section">
    <div class="hero-content">
        <span class="hero-label">DISCOVER • EXPLORE • PLAN</span>

        <h1>Discover your next experience.</h1>

        <p class="search-subtitle">
            Find unforgettable events across Ireland and plan
            ahead with live weather forecasts.
        </p>
    </div>

    <div class="search-panel">
        <div class="mb-3">
            <label class="form-label" for="event-search">
                Search Events
            </label>

            <input id="event-search"
                   class="form-control"
                   placeholder="Search concerts, artists or events..."
                   @bind="searchKeyword" />
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label" for="city-filter">City</label>

                <select id="city-filter"
                        class="form-select"
                        @bind="selectedCity"
                        @bind:after="LoadEvents">
                    <option value="">All Cities</option>
                    <option value="Dublin">Dublin</option>
                    <option value="Cork">Cork</option>
                    <option value="Galway">Galway</option>
                    <option value="Limerick">Limerick</option>
                    <option value="Waterford">Waterford</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label" for="category-filter">Category</label>

                <select id="category-filter"
                        class="form-select"
                        @bind="selectedCategory"
                        @bind:after="LoadEvents">
                    <option value="">All Categories</option>
                    <option value="Music">Music</option>
                    <option value="Sports">Sports</option>
                    <option value="Arts &amp; Theatre">Arts &amp; Theatre</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label" for="sort-filter">Sort By</label>

                <select id="sort-filter"
                        class="form-select"
                        @bind="selectedSort"
                        @bind:after="SortEvents">
                    <option value="dateAsc">Date: Earliest First</option>
                    <option value="dateDesc">Date: Latest First</option>
                    <option value="nameAsc">Event Name: A-Z</option>
                    <option value="nameDesc">Event Name: Z-A</option>
                </select>
            </div>
        </div>

        <button class="btn btn-primary search-button mt-3"
                @onclick="LoadEvents"
                disabled="@isLoading">
            @(isLoading ? "Searching..." : "Search Events")
        </button>
    </div>
</section>

<section class="results-section">
    <div class="results-header">
        <div>
            <h2>Explore Events</h2>
            <p class="results-message" role="status">@message</p>
        </div>
    </div>

    @if (events.Count > 0)
    {
        <div class="row g-4">
            @foreach (var item in events)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card event-card h-100">

                        @if (item.Images?.Count > 0)
                        {
                            var image = item.Images
                                .Where(i => !string.IsNullOrWhiteSpace(i.Url))
                                .OrderByDescending(i => i.Width)
                                .FirstOrDefault();

                            @if (image != null)
                            {
                                <img src="@image.Url"
                                     class="card-img-top"
                                     alt="@item.Name"
                                     loading="lazy" />
                            }
                        }

                        <div class="card-body">
                            <h3 class="card-title">
                                @item.Name
                            </h3>

                            <div class="event-details">
                                <p>
                                    <span class="detail-label">Date</span>
                                    <span>@(item.Dates?.Start?.LocalDate ?? "Unavailable")</span>
                                </p>

                                <p>
                                    <span class="detail-label">Time</span>
                                    <span>@(item.Dates?.Start?.LocalTime ?? "Unavailable")</span>
                                </p>

                                <p>
                                    <span class="detail-label">Venue</span>
                                    <span>@(item.Embedded?.Venues?.FirstOrDefault()?.Name ?? "Unavailable")</span>
                                </p>

                                <p>
                                    <span class="detail-label">City</span>
                                    <span>@(item.Embedded?.Venues?.FirstOrDefault()?.City?.Name ?? "Unavailable")</span>
                                </p>
                            </div>

                            <div class="event-actions">
                                @if (!string.IsNullOrWhiteSpace(item.Url))
                                {
                                    <a href="@item.Url"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-primary">
                                        View Tickets ↗
                                    </a>
                                }

                                <button class="btn btn-success"
                                        @onclick="() => CheckEventWeather(item)">
                                    Check Weather
                                </button>
                            </div>

                            @if (weatherMessages.TryGetValue(item.Id ?? "", out var forecastMessage))
                            {
                                <div class="weather-result" role="status">
                                    <span class="weather-symbol">☁</span>
                                    <span>@forecastMessage</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!isLoading && hasSearched)
    {
        <div class="empty-state">
            <h3>No matching events</h3>
            <p>Try another keyword, city or category to discover more events.</p>
        </div>
    }
</section>

@code {
    private List<EventPlanner.Models.Event> events = new();
    private string message = "Use the search above to discover events.";
    private string searchKeyword = "";
    private string selectedCity = "";
    private string selectedCategory = "";
    private string selectedSort = "dateAsc";

    private bool isLoading = false;
    private bool hasSearched = false;

    private Dictionary<string, string> weatherMessages = new();

    private async Task LoadEvents()
    {
        isLoading = true;
        message = "Searching for events...";

        weatherMessages.Clear();

        try
        {
            events = await EventService.GetEventsAsync(
                searchKeyword, selectedCity, selectedCategory);

            SortEvents();

            message = events.Count == 0
                ? "No events found. Try a different search or filter."
                : $"Found {events.Count} events!";
        }
        catch (HttpRequestException)
        {
            events.Clear();
            message = "Unable to retrieve events. Please try again later.";
        }
        catch (Exception)
        {
            events.Clear();
            message = "Something went wrong while loading events.";
        }
        finally
        {
            isLoading = false;
            hasSearched = true;
        }
    }

    private async Task CheckEventWeather(EventPlanner.Models.Event item)
    {
        string eventId = item.Id ?? "";

        var venue = item.Embedded?.Venues?.FirstOrDefault();
        string? dateText = item.Dates?.Start?.LocalDate;

        // Convert Ticketmaster's venue coordinates to numbers.
        if (venue?.Location == null ||
            !double.TryParse(venue.Location.Latitude,
                System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture,
                out double latitude) ||
            !double.TryParse(venue.Location.Longitude,
                System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture,
                out double longitude))
        {
            weatherMessages[eventId] = "Venue coordinates unavailable.";
            return;
        }

        // Validate coordinates before requesting weather data.
        if (!WeatherValidator.AreCoordinatesValid(latitude, longitude))
        {
            weatherMessages[eventId] = "Invalid venue coordinates.";
            return;
        }

        // Convert the event date from text to a DateOnly value.
        if (!DateOnly.TryParseExact(dateText, "yyyy-MM-dd",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None,
                out DateOnly eventDate))
        {
            weatherMessages[eventId] = "Event date unavailable.";
            return;
        }

        DateOnly today = DateOnly.FromDateTime(DateTime.Today);

        // Open-Meteo forecasts are limited to the supported date range.
        if (!WeatherValidator.IsDateValid(eventDate, today))
        {
            weatherMessages[eventId] =
                "Forecast not available yet. Check closer to the event date.";
            return;
        }

        weatherMessages[eventId] = "Loading forecast...";

        try
        {
            var weather = await WeatherService.GetEventForecastAsync(
                latitude, longitude, eventDate);

            if (weather?.Daily?.MaxTemperature?.Count > 0 &&
                weather.Daily.MinTemperature?.Count > 0 &&
                weather.Daily.RainProbability?.Count > 0)
            {
                weatherMessages[eventId] =
                    $"Temperature: {weather.Daily.MinTemperature[0]}°C – " +
                    $"{weather.Daily.MaxTemperature[0]}°C | " +
                    $"Rain probability: {weather.Daily.RainProbability[0]}%";
            }
            else
            {
                weatherMessages[eventId] = "Forecast unavailable.";
            }
        }
        catch (HttpRequestException)
        {
            weatherMessages[eventId] =
                "Weather service is temporarily unavailable. Please try again.";
        }
        catch (Exception)
        {
            weatherMessages[eventId] = "Unable to load the weather forecast.";
        }
    }

    private void SortEvents()
    {
        events = EventSorter.SortEvents(events, selectedSort);
    }
}