@page "/"
@rendermode InteractiveServer
@using EventPlanner.Services
@inject EventService EventService
@inject WeatherService WeatherService

<PageTitle>Event Planner</PageTitle>

<h1>Event Planner</h1>
<p>Discover events happening in Ireland.</p>

<div class="mb-3">
    <input class="form-control"
           placeholder="Search for concerts, artists or events..."
           @bind="searchKeyword" />
</div>

<div class="mb-3">
    <label class="form-label">Select City</label>

    <select class="form-select" @bind="selectedCity">
        <option value="">All Cities</option>
        <option value="Dublin">Dublin</option>
        <option value="Cork">Cork</option>
        <option value="Galway">Galway</option>
        <option value="Limerick">Limerick</option>
        <option value="Waterford">Waterford</option>
    </select>
</div>

<button class="btn btn-primary mb-3" @onclick="LoadEvents">
    Search Events
</button>

<button class="btn btn-success mb-3 ms-2" @onclick="TestWeather">
    Test Weather API
</button>

<p>@weatherMessage</p>

<p>@message</p>

<div class="row">
    @foreach (var item in events)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">

                @if (item.Images?.Count > 0)
                {
                    <img src="@item.Images[0].Url"
                         class="card-img-top"
                         alt="@item.Name"
                         style="height:200px; object-fit:cover;" />
                }

                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>

                    <p>
                        <strong>Date:</strong>
                        @item.Dates?.Start?.LocalDate
                    </p>

                    <p>
                        <strong>Time:</strong>
                        @item.Dates?.Start?.LocalTime
                    </p>

                    <p>
                        <strong>Venue:</strong>
                        @item.Embedded?.Venues?.FirstOrDefault()?.Name
                    </p>

                    <p>
                        <strong>City:</strong>
                        @item.Embedded?.Venues?.FirstOrDefault()?.City?.Name
                    </p>

                    @if (!string.IsNullOrWhiteSpace(item.Url))
                    {
                        <a href="@item.Url"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-primary">
                            View Tickets
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<EventPlanner.Models.Event> events = new();
    private string message = "Click the button to load events.";
    private string searchKeyword = "";
    private string selectedCity = "";

    private async Task LoadEvents()
    {
        message = "Loading events...";

        try
        {
            events = await EventService.GetEventsAsync(searchKeyword, selectedCity);

            message = $"Found {events.Count} events!";
        }
        catch (Exception ex)
        {
            events.Clear();
            message = $"Error: {ex.Message}";
        }
    }
    
    private string weatherMessage = "";

    private async Task TestWeather()
    {
        weatherMessage = "Loading weather...";

        try
        {
            // Dublin coordinates for testing
            var weather = await WeatherService.GetWeatherAsync(
                53.3498, -6.2603);

            if (weather?.Current != null)
            {
                weatherMessage =
                    $"Dublin Temperature: {weather.Current.Temperature}°C, " +
                    $"Precipitation: {weather.Current.Precipitation} mm";
            }
            else
            {
                weatherMessage = "No weather data available.";
            }
        }
        catch (Exception ex)
        {
            weatherMessage = $"Weather Error: {ex.Message}";
        }
    }
}